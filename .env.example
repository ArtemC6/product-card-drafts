# Скопируйте в .env (он в .gitignore) и заполните.

# OpenAI
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Локальная модель через Ollama (или vLLM): раскомментируйте, ключ не нужен
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b

# Необязательные параметры
# LLM_TEMPERATURE=0.3
# LLM_MAX_ATTEMPTS=3
# LLM_TIMEOUT=60
